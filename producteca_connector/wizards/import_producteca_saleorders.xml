<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_producteca_saleorders_wizard_form" model="ir.ui.view">
        <field name="name">producteca.saleorders.wizard.form</field>
        <field name="model">producteca.saleorders.wizard</field>
        <field name="arch" type="xml">
            <form string="Obtener Ordenes de Venta de Producteca">
                <group>
                    <field name="producteca_account_id"/>
                    <field name="search_text"/>
                </group>
                <footer>
                    <button name="action_obtain_saleorders" string="Obtener Ordenes de Venta" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_producteca_saleorders_wizard" model="ir.actions.act_window">
        <field name="name">Obtener Ordenes de Venta de Producteca</field>
        <field name="res_model">producteca.saleorders.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_obtain_producteca_saleorders"
        name="Obtener Ordenes de Venta de Producteca"
        parent="menu_producteca_imports"
        action="action_producteca_saleorders_wizard"
        sequence="11"/>
</odoo>

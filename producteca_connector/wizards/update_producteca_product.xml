<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_update_producteca_product_wizard" model="ir.ui.view">
        <field name="name">update.producteca.product.wizard</field>
        <field name="model">update.producteca.product</field>
        <field name="arch" type="xml">
            <form string="Actualizar Producto en Producteca">
                <group>
                    <field name="warning_message" colspan="2" nolabel="1"/>
                    <field name="product_tmpl_id" invisible="1"/>
                    <field name="account_ids" widget="many2many_tags" 
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button string="Actualizar" name="action_update_product" 
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_create_queue" model="ir.cron">
        <field name="name">Producteca: Crear Cola de Productos</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.create_product_in_producteca_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_process_product_create_queue" model="ir.cron">
        <field name="name">Producteca: Procesar Cola de Creación de Productos</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.process_product_create_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_process_product_update_queue" model="ir.cron">
        <field name="name">Producteca: Procesar Cola de Actualización de Productos</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.process_product_update_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_process_product_stock_queue" model="ir.cron">
        <field name="name">Producteca: Procesar Cola de Stock de Productos</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.process_product_stock_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_obtain_producteca_products_process_queue" model="ir.cron">
        <field name="name">Producteca: Obtener y Procesar Productos</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.obtain_producteca_products_process_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_enqueue_last_x_days_orders_from_producteca" model="ir.cron">
        <field name="name">Producteca: Encolar Órdenes de los Últimos X Días</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.enqueue_last_x_days_orders_from_producteca()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_process_producteca_orders_queue" model="ir.cron">
        <field name="name">Producteca: Procesar Cola de Órdenes</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.process_producteca_order_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_process_queue_product_create_in_odoo" model="ir.cron">
        <field name="name">Producteca: Procesar Cola de Creación de Productos en Odoo</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.process_queue_product_create_in_odoo()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_create_stock_picking_queue" model="ir.cron">
        <field name="name">Producteca: Procesar Cola de Creación de Shipments</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.process_create_stock_picking_queue()</field>
        <field name="interval_number">20</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_update_stock_picking_queue" model="ir.cron">
        <field name="name">Producteca: Procesar Cola de Actualización de Shipments</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.process_update_stock_picking_queue()</field>
        <field name="interval_number">20</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
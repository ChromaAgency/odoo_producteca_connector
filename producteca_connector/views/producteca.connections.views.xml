<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_producteca_connections_list" model="ir.ui.view">
        <field name="name">producteca.product.connections.list</field>
        <field name="model">producteca.product.connections</field>
        <field name="arch" type="xml">
            <list string="Producteca Connections">
                <field name="producteca_account_id"/>
                <field name="product_tmpl_id"/>
                <field name="producteca_id"/>
            </list>
        </field>
    </record>

    <record id="view_producteca_connections_form" model="ir.ui.view">
        <field name="name">producteca.product.connections.form</field>
        <field name="model">producteca.product.connections</field>
        <field name="arch" type="xml">
            <form string="Producteca Connection">
                <sheet>
                    <group>
                        <field name="producteca_account_id"/>
                        <field name="product_tmpl_id"/>
                        <field name="producteca_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_producteca_connections" model="ir.actions.act_window">
        <field name="name">Producteca Connections</field>
        <field name="res_model">producteca.product.connections</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_producteca_connections"
              name="Conexiones"
              parent="menu_producteca_root"
              action="action_producteca_connections"
              sequence="30"/>

</odoo>
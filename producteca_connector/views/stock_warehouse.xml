<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warehouse_stock_view_inherit_producteca" model="ir.ui.view">
        <field name="name">stock.warehouse.view.form.inherit_producteca</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="producteca_warehouse_name"/>
            </xpath>
        </field>

    </record>

</odoo>

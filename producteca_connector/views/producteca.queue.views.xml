<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_producteca_queue_list" model="ir.ui.view">
        <field name="name">producteca.queue.list</field>
        <field name="model">producteca.queue</field>
        <field name="arch" type="xml">
            <list string="Producteca Queue">
                <field name="active"/>
                <field name="producteca_account_id"/>
                <field name="producteca_method"/>
                <field name="response_status"/>
                <field name="model"/>
                <field name="producteca_response"/>
            </list>
        </field>
    </record>

    <record id="view_producteca_queue_form" model="ir.ui.view">
        <field name="name">producteca.queue.form</field>
        <field name="model">producteca.queue</field>
        <field name="arch" type="xml">
            <form string="Producteca Queue">
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="producteca_account_id"/>
                        <field name="producteca_method"/>
                        <field name="model"/>
                    </group>
                    <notebook>
                        <page string="Contenido">
                            <field name="producteca_body"/>
                        </page>
                        <page string="Respuesta">
                            <group>
                                <field name="response_status" readonly="1"/>
                                <field name="producteca_response" readonly="1"/>
                                <field name="internal_process_error_msg" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_producteca_queue_search" model="ir.ui.view">
        <field name="name">producteca.queue.search</field>
        <field name="model">producteca.queue</field>
        <field name="arch" type="xml">
            <search string="Buscar en Cola de Producteca">
                <field name="producteca_account_id"/>
                <field name="model"/>
                <field name="producteca_method"/>
                <field name="response_status"/>
                <filter string="Activos" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archivado" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Agrupar por...">
                    <filter string="Cuenta Producteca" name="group_by_account" context="{'group_by': 'producteca_account_id'}"/>
                    <filter string="Modelo" name="group_by_model" context="{'group_by': 'model'}"/>
                    <filter string="Método" name="group_by_method" context="{'group_by': 'producteca_method'}"/>
                    <filter string="Estado Respuesta" name="group_by_status" context="{'group_by': 'response_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_producteca_queue" model="ir.actions.act_window">
        <field name="name">Producteca Queue</field>
        <field name="res_model">producteca.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_producteca_queue_search"/>
        <!-- <field name="context">{'search_default_filter_active': 1}</field> -->
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click para crear una nueva entrada en la cola de Producteca
            </p>
        </field>
    </record>

    <menuitem id="menu_producteca_queue"
              name="Cola de Producteca"
              parent="menu_producteca_root"
              action="action_producteca_queue"
              sequence="20"/>

</odoo>
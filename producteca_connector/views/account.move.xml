<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_inherit_producteca" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit_producteca</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="producteca_payment_state" readonly="1"/>
                <group>
                <field name="producteca_account_id" groups="base.group_no_one"/>
                <field name="producteca_order_id" groups="base.group_no_one"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
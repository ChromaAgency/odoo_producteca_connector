<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_producteca_account_list" model="ir.ui.view">
        <field name="name">producteca.account.list</field>
        <field name="model">producteca.account</field>
        <field name="arch" type="xml">
            <list string="Producteca Accounts">
                <field name="account_name"/>
                <field name="company_id" widget="many2one_tags"/>
                <field name="is_stock_modified_by_producteca"/>
                <field name="is_product_price_modified_by_producteca"/>
            </list>
        </field>
    </record>

    <record id="view_producteca_account_form" model="ir.ui.view">
        <field name="name">producteca.account.form</field>
        <field name="model">producteca.account</field>
        <field name="arch" type="xml">
            <form string="Producteca Account">
                <sheet>
                    <group>
                        <field name="account_name"/>
                        <field name="api_key"/>
                        <field name="bearer_token"/>
                    </group>
                    <notebook>
                        <page string="Configuración">
                            <group>
                                <field name="company_id"/>
                                <field name="imported_sale_action"/>
                                <field name="default_warehouse_id"/>
                                <field name="warehouse_ids" widget="many2many_tags"/>
                                <field name="pricelist_to_sync"/>
                            </group>
                        </page>
                        <page string="Opciones">
                            <group>
                                <field name="is_producteca_able_to_create_products"/>
                                <field name="is_stock_modified_by_producteca"/>
                                <field name="is_product_price_modified_by_producteca"/>
                                <field name="create_if_dosnt_exist"/>
                                <field name="get_orders_from_last_days"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_producteca_account" model="ir.actions.act_window">
        <field name="name">Producteca Accounts</field>
        <field name="res_model">producteca.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click para crear una nueva cuenta de Producteca
            </p>
        </field>
    </record>

    <menuitem id="menu_producteca_account"
              name="Cuentas"
              parent="menu_producteca_root"
              action="action_producteca_account"
              sequence="10"/>

</odoo>
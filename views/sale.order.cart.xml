<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_cart_list" model="ir.ui.view">
        <field name="name">sale.order.cart.list</field>
        <field name="model">sale.order.cart</field>
        <field name="arch" type="xml">
            <list string="Sale Order Carts" create="false">
                <field name="producteca_id"/>
                <field name="order_ids" string="Orders"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_cart_form" model="ir.ui.view">
        <field name="name">sale.order.cart.form</field>
        <field name="model">sale.order.cart</field>
        <field name="arch" type="xml">
            <form string="Sale Order Cart" create="false">
                <sheet>
                    <group>
                        <field name="producteca_id"/>
                    </group>
                    <notebook>
                        <page string="Orders">
                            <field name="order_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="amount_total"/>
                                    <field name="date_order"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_order_cart" model="ir.actions.act_window">
        <field name="name">Sale Order Carts</field>
        <field name="res_model">sale.order.cart</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_producteca_carts"
              name="Carts"
              parent="menu_producteca_root"
              action="action_sale_order_cart"
              sequence="30"/>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_create_queue" model="ir.cron">
        <field name="name">Create Producteca Queue</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.create_product_in_producteca_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_process_product_create_queue" model="ir.cron">
        <field name="name">Process Producteca Create Queue</field>
        <field name="model_id" ref="model_producteca_queue"/>
        <field name="state">code</field>
        <field name="code">model.process_product_create_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>